# Backend Dockerfile (development-friendly)
FROM node:18

WORKDIR /app

# Install dependencies (include dev deps for tsc)
COPY Backend/package*.json ./
RUN npm install

# Copy backend source
COPY Backend/ ./

# Build TypeScript
RUN npm run build

EXPOSE 5002

# Run DB setup then start the built server
CMD ["sh", "-c", "npm run setup-db && npm run start"]
