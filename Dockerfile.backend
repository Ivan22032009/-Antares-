# Backend Dockerfile (development-friendly)
FROM node:18

WORKDIR /app

# Install dependencies (include dev deps for tsc)
COPY package*.json ./
RUN npm install

# Copy backend source
COPY . ./

# Build TypeScript
RUN npm run build

EXPOSE 5002

# Copy entrypoint script and make executable
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Run DB setup then start the built server (entrypoint will ensure deps)
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["sh", "-c", "npm run setup-db && npm run start"]
