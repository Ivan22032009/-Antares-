# Frontend Dockerfile
FROM node:18

WORKDIR /app

# Copy package manifests and install
COPY package*.json ./
RUN npm install

# Copy frontend source
COPY . ./

# Build the app
RUN npm run build

EXPOSE 3000

# Serve the built app using vite preview on port 3000
CMD ["npm", "run", "preview", "--", "--port", "3000", "--host"]
